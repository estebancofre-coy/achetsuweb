# ACHETSU Apps Script Configuration
# This file serves as documentation for required environment variables.
# DO NOT commit real values—use GitHub Secrets for production.

# The public URL of the ACHETSU Apps Script deployment (/exec endpoint)
# This is injected at deploy time by the CI/CD workflow.
# To set it up in GitHub:
#   1. Go to https://github.com/estebancofre-coy/achetsuweb/settings/secrets/actions
#   2. Create a new secret named: ACHETSU_APPS_SCRIPT_URL
#   3. Paste the full /exec URL from your Apps Script deployment
ACHETSU_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
